# P08_NavReadyPCG repository: docs + the UE project in NavReadyPCG/.
# Generated by Unreal / Visual Studio. Never commit.
NavReadyPCG/Binaries/
NavReadyPCG/Intermediate/
NavReadyPCG/Saved/
NavReadyPCG/DerivedDataCache/
NavReadyPCG/Build/
NavReadyPCG/Plugins/*/Binaries/
NavReadyPCG/Plugins/*/Intermediate/
NavReadyPCG/.vs/
NavReadyPCG/*.sln
NavReadyPCG/*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Python
__pycache__/

# Packaged builds stay out of git.
Build/

# Benchmarks: raw captures, run reports and logs stay local (too large for git; UE logs also hold
# machine-specific paths). Manifests and Summaries/ are committed; cited raw batches go to GitHub Releases.
Benchmarks/Raw/*
!Benchmarks/Raw/*_manifest.json
Benchmarks/*_console.txt

# Parked code or doc drafts (never committed; survives a reboot, unlike the shared scratchpad).
_wip/
